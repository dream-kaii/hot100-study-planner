// wrangler.online-runner.example.jsonc
// 这是"启用在线运行"时要合并到 wrangler.jsonc 的增量配置。
//
// 现在它不生效：wrangler.jsonc 的 main 仍指向 src/worker.js。
// 要启用时，把下面三处抄进 wrangler.jsonc：
//   1. main 改成 src/online/index.js
//   2. 增加 durable_objects 段（两个类：Session 管会话，Lobby 管配对码索引）
//   3. 增加 migrations 段
// 要回滚，把 main 改回 src/worker.js、删掉这两段、重新部署即可。
//
// 免费额度参考（Workers Free）：
//   Durable Objects Requests   100,000 / 天（WS 消息按 20:1 折算）
//   Duration                  13,000 GB-s / 天 ≈ 28 小时活跃连接
//   Free 计划只支持 SQLite backend（下面迁移用的就是 new_sqlite_classes）
// 因为用了 WebSocket Hibernation，空闲连接不计 duration，免费额度对个人使用绰绰有余。
//
// 注意：migrations 的 tag 一旦部署过就不能改。当前 v1 同时创建两个类；
// 如果未来要加新类，追加一条 { "tag": "v2", "new_sqlite_classes": ["新类"] }。

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hot100-study-planner",
  "main": "src/online/index.js",
  "compatibility_date": "2026-06-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [],

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Session", "Lobby"] }
  ]
}
